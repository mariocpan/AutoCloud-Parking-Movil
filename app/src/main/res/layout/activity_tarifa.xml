<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="68dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Tarifa"
        android:textSize="24sp"
        android:textStyle="bold" />

    <EditText
        android:id ="@+id/et_placa_tarifa"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:hint="número de placa o codigo" />

    <Button
        android:id="@+id/btnCalcular"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="#FDDD13"
        android:text="Calcular" />

    <Button
        android:id ="@+id/btnCancelar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="#C31111"
        android:text="Cancelar" />

      <TextView
        android:id ="@+id/tv_tarifa_resultado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Valor total a pagar: --"
        android:textSize="18sp"
        android:textStyle="bold"/>

    <Button
        android:id="@+id/btnCobrar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="#1B5E20"
        android:text="Confirmar"
        android:visibility="gone" />

</LinearLayout>